cabal-version:      2.4
name:               smsgora
version:            1.0.0
synopsis:           SMS Gora SMS Gateway client: send and receive SMS through your own Android phones
description:        SMS Gora SMS Gateway: official Haskell client by Tekservix. Send single and bulk SMS through your own Android phones and SIM cards, check delivery, read incoming SMS, manage webhooks and verify their signatures. Requires a Tekservix account with SMS Gora: <https://tekservix.com/smsgora>.
homepage:           https://tekservix.com/smsgora
bug-reports:        https://github.com/TekservixHQ/smsgora-haskell/issues
license:            MIT
license-file:       LICENSE
author:             Tekservix
maintainer:         support@tekservix.com
copyright:          (c) 2026 Tekservix
category:           Network, Web, API
build-type:         Simple
extra-doc-files:    README.md
                    CHANGELOG.md
tested-with:        GHC == 9.4.8, GHC == 9.6.6, GHC == 9.8.4, GHC == 9.10.1

source-repository head
  type:     git
  location: https://github.com/TekservixHQ/smsgora-haskell.git

library
  exposed-modules:  Network.SmsGora
  hs-source-dirs:   src
  default-language: Haskell2010
  ghc-options:      -Wall
  build-depends:    base >= 4.14 && < 5
                    , aeson >= 2.0 && < 2.3
                    , bytestring >= 0.10 && < 0.13
                    , text >= 1.2 && < 2.2
                    , http-client >= 0.7 && < 0.8
                    , http-client-tls >= 0.3.6 && < 0.4
                    , http-types >= 0.12 && < 0.13
                    , cryptohash-sha256 >= 0.11 && < 0.12
                    , base16-bytestring >= 1.0 && < 1.1

test-suite spec
  type:             exitcode-stdio-1.0
  main-is:          Main.hs
  hs-source-dirs:   test
  default-language: Haskell2010
  ghc-options:      -Wall
  build-depends:    base, smsgora, text, bytestring
